{
  "schema": "cli.schema.v1",
  "tool": "lmconn",
  "version": "0.1.0",
  "policy": {
    "dryrun": false,
    "readonly": false
  },
  "inputs": [
    "flags",
    "json"
  ],
  "operations": [
    {
      "name": "cred_set",
      "access": "write",
      "description": "Store a credential using exactly one of value, env, or stdin",
      "params": [
        {
          "name": "service",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Service name"
        },
        {
          "name": "field",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Credential field name"
        },
        {
          "name": "value",
          "type": "string",
          "occurs": "?",
          "description": "Credential value (visible in argv; prefer env or stdin)"
        },
        {
          "name": "env",
          "type": "string",
          "occurs": "?",
          "description": "Environment variable containing the credential"
        },
        {
          "name": "stdin",
          "type": "boolean",
          "occurs": "?",
          "description": "Read the complete credential from stdin"
        }
      ]
    },
    {
      "name": "cred_get",
      "access": "read",
      "description": "Check presence; reveal returns the value or NOT_FOUND",
      "params": [
        {
          "name": "service",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Service name"
        },
        {
          "name": "field",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Credential field name"
        },
        {
          "name": "reveal",
          "type": "boolean",
          "occurs": "?",
          "description": "Include the secret value in the result for piping"
        }
      ]
    },
    {
      "name": "cred_list",
      "access": "read",
      "description": "List credential names and timestamps only",
      "params": []
    },
    {
      "name": "cred_delete",
      "access": "write",
      "description": "Delete a credential",
      "params": [
        {
          "name": "service",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Service name"
        },
        {
          "name": "field",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Credential field name"
        }
      ]
    },
    {
      "name": "cred_path",
      "access": "read",
      "description": "Return the credential database path",
      "params": []
    },
    {
      "name": "cred_oauth_store",
      "access": "write",
      "description": "Atomically store an OAuth2 token from JSON stdin and return its service handle",
      "params": [
        {
          "name": "service",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Provider/account service handle"
        },
        {
          "name": "stdin",
          "type": "boolean",
          "occurs": "1",
          "description": "Read the token and metadata JSON from stdin"
        }
      ]
    },
    {
      "name": "llm_providers",
      "access": "read",
      "description": "List providers and credential sources (never keys)",
      "params": []
    },
    {
      "name": "llm_chat",
      "access": "write",
      "description": "Send a prompt to an LLM provider",
      "params": [
        {
          "name": "provider",
          "type": "string",
          "positional": true,
          "description": "Provider name"
        },
        {
          "name": "model",
          "type": "string",
          "occurs": "?",
          "description": "model"
        },
        {
          "name": "system",
          "type": "string",
          "occurs": "?",
          "description": "system"
        },
        {
          "name": "prompt",
          "type": "string",
          "occurs": "?",
          "description": "prompt"
        },
        {
          "name": "promptFile",
          "type": "string",
          "occurs": "?",
          "description": "Read prompt from a UTF-8 file"
        },
        {
          "name": "maxTokens",
          "type": "number",
          "occurs": "?",
          "default": 256,
          "description": "Maximum API completion tokens"
        },
        {
          "name": "stdin",
          "type": "boolean",
          "occurs": "?",
          "description": "Read prompt from stdin (default without a prompt option)"
        }
      ]
    },
    {
      "name": "llm_probe",
      "access": "write",
      "description": "Probe selected providers, or all providers by default",
      "params": [
        {
          "name": "provider",
          "type": "array",
          "occurs": "*",
          "items": "string",
          "description": "Provider names"
        }
      ]
    },
    {
      "name": "http_request",
      "access": "write",
      "description": "Send one HTTP request and return status, headers summary and the body (JSON parsed when possible)",
      "params": [
        {
          "name": "url",
          "type": "string",
          "positional": true,
          "description": "Absolute http(s) URL"
        },
        {
          "name": "method",
          "type": "string",
          "occurs": "?",
          "default": "GET",
          "description": "HTTP method (default GET, or POST when data is given)"
        },
        {
          "name": "header",
          "type": "array",
          "occurs": "*",
          "items": "string",
          "description": "Request header as \"Name: value\" (repeatable)"
        },
        {
          "name": "data",
          "type": "string",
          "occurs": "?",
          "description": "Request body (sets Content-Type application/json when it parses as JSON)"
        },
        {
          "name": "dataFile",
          "type": "string",
          "occurs": "?",
          "description": "Read the request body from a file"
        },
        {
          "name": "auth",
          "type": "string",
          "occurs": "?",
          "description": "Credential service whose API key or OAuth access token is sent as Authorization: Bearer"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 30000,
          "description": "Timeout in milliseconds"
        }
      ]
    },
    {
      "name": "github_user",
      "access": "read",
      "description": "Return the authenticated GitHub user (login, name, id, publicRepos)",
      "params": []
    },
    {
      "name": "github_repos",
      "access": "read",
      "description": "List repository names of an organisation or user",
      "params": [
        {
          "name": "org",
          "type": "string",
          "positional": true,
          "description": "Organisation or user login"
        },
        {
          "name": "limit",
          "type": "number",
          "occurs": "?",
          "default": 30,
          "description": "Maximum number of names (1..1000)"
        }
      ]
    },
    {
      "name": "oauth_authorize",
      "access": "write",
      "description": "Authorize with a loopback callback and PKCE",
      "params": [
        {
          "name": "service",
          "type": "string",
          "positional": true,
          "description": "Credential service name"
        },
        {
          "name": "clientId",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_client_id"
        },
        {
          "name": "clientSecret",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_client_secret"
        },
        {
          "name": "authUrl",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_auth_url"
        },
        {
          "name": "deviceUrl",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_device_url"
        },
        {
          "name": "tokenUrl",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_token_url"
        },
        {
          "name": "scope",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_scope"
        },
        {
          "name": "authQuery",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_auth_query"
        },
        {
          "name": "authStyle",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_auth_style"
        },
        {
          "name": "owner",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_owner"
        },
        {
          "name": "source",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_source"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "default": 0,
          "description": "Loopback port (0 chooses an ephemeral port)"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 300000,
          "description": "Authorization deadline in milliseconds"
        },
        {
          "name": "noPkce",
          "type": "boolean",
          "occurs": "?",
          "description": "Disable PKCE for legacy providers"
        },
        {
          "name": "autoFollow",
          "type": "boolean",
          "occurs": "?",
          "description": "Follow authorization redirects automatically for demos and mock IdPs"
        },
        {
          "name": "manual",
          "type": "boolean",
          "occurs": "?",
          "description": "Read a full redirect URL from stdin"
        }
      ]
    },
    {
      "name": "oauth_refresh",
      "access": "write",
      "description": "Refresh stored OAuth credentials",
      "params": [
        {
          "name": "service",
          "type": "string",
          "positional": true,
          "description": "Credential service name"
        }
      ]
    },
    {
      "name": "oauth_status",
      "access": "read",
      "description": "Show OAuth status without tokens",
      "params": [
        {
          "name": "service",
          "type": "string",
          "positional": true,
          "description": "Credential service name"
        }
      ]
    },
    {
      "name": "oauth_list",
      "access": "read",
      "description": "List OAuth credential metadata without tokens",
      "params": []
    },
    {
      "name": "oauth_device",
      "access": "write",
      "description": "Authorize with an OAuth2 device code",
      "params": [
        {
          "name": "service",
          "type": "string",
          "positional": true,
          "description": "Credential service name"
        },
        {
          "name": "clientId",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_client_id"
        },
        {
          "name": "deviceUrl",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_device_url"
        },
        {
          "name": "tokenUrl",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_token_url"
        },
        {
          "name": "scope",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_scope"
        },
        {
          "name": "owner",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_owner"
        },
        {
          "name": "source",
          "type": "string",
          "occurs": "?",
          "description": "Override stored oauth_source"
        }
      ]
    },
    {
      "name": "valkey_ping",
      "access": "read",
      "description": "Ping Valkey server via native RESP or REST",
      "params": [
        {
          "name": "host",
          "type": "string",
          "occurs": "?",
          "default": "127.0.0.1",
          "description": "Valkey host"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "description": "Valkey port (default 6379 for resp, 8080 for rest)"
        },
        {
          "name": "mode",
          "type": "string",
          "occurs": "?",
          "default": "resp",
          "enum": [
            "resp",
            "rest"
          ],
          "description": "Protocol mode: resp or rest"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 5000,
          "description": "Timeout in milliseconds"
        }
      ]
    },
    {
      "name": "valkey_get",
      "access": "read",
      "description": "Get a key from Valkey",
      "params": [
        {
          "name": "key",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Key name"
        },
        {
          "name": "host",
          "type": "string",
          "occurs": "?",
          "default": "127.0.0.1",
          "description": "Valkey host"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "description": "Valkey port"
        },
        {
          "name": "mode",
          "type": "string",
          "occurs": "?",
          "default": "resp",
          "enum": [
            "resp",
            "rest"
          ],
          "description": "Protocol mode: resp or rest"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 5000,
          "description": "Timeout in milliseconds"
        }
      ]
    },
    {
      "name": "valkey_set",
      "access": "write",
      "description": "Set a key in Valkey",
      "params": [
        {
          "name": "key",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Key name"
        },
        {
          "name": "value",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Value to store"
        },
        {
          "name": "host",
          "type": "string",
          "occurs": "?",
          "default": "127.0.0.1",
          "description": "Valkey host"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "description": "Valkey port"
        },
        {
          "name": "mode",
          "type": "string",
          "occurs": "?",
          "default": "resp",
          "enum": [
            "resp",
            "rest"
          ],
          "description": "Protocol mode: resp or rest"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 5000,
          "description": "Timeout in milliseconds"
        }
      ]
    },
    {
      "name": "valkey_del",
      "access": "write",
      "description": "Delete a key in Valkey",
      "params": [
        {
          "name": "key",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Key name"
        },
        {
          "name": "host",
          "type": "string",
          "occurs": "?",
          "default": "127.0.0.1",
          "description": "Valkey host"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "description": "Valkey port"
        },
        {
          "name": "mode",
          "type": "string",
          "occurs": "?",
          "default": "resp",
          "enum": [
            "resp",
            "rest"
          ],
          "description": "Protocol mode: resp or rest"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 5000,
          "description": "Timeout in milliseconds"
        }
      ]
    },
    {
      "name": "valkey_cmd",
      "access": "write",
      "description": "Execute arbitrary command against Valkey",
      "params": [
        {
          "name": "command",
          "type": "string",
          "occurs": "1",
          "positional": true,
          "description": "Command name"
        },
        {
          "name": "args",
          "type": "array",
          "occurs": "*",
          "items": "string",
          "description": "Command arguments"
        },
        {
          "name": "host",
          "type": "string",
          "occurs": "?",
          "default": "127.0.0.1",
          "description": "Valkey host"
        },
        {
          "name": "port",
          "type": "number",
          "occurs": "?",
          "description": "Valkey port"
        },
        {
          "name": "mode",
          "type": "string",
          "occurs": "?",
          "default": "resp",
          "enum": [
            "resp",
            "rest"
          ],
          "description": "Protocol mode: resp or rest"
        },
        {
          "name": "timeout",
          "type": "number",
          "occurs": "?",
          "default": 5000,
          "description": "Timeout in milliseconds"
        }
      ]
    }
  ],
  "globals": [
    {
      "name": "readonly",
      "type": "boolean",
      "occurs": "?",
      "aliases": [
        "read-only"
      ],
      "description": "Refuse to run write operations"
    },
    {
      "name": "json",
      "type": "boolean",
      "occurs": "?",
      "description": "Output as JSON (the envelope is always JSON)"
    },
    {
      "name": "help",
      "type": "boolean",
      "occurs": "?",
      "aliases": [
        "h"
      ],
      "description": "Show help"
    },
    {
      "name": "input-json",
      "type": "string",
      "occurs": "?",
      "aliases": [
        "inputJson"
      ],
      "description": "JSON document input"
    },
    {
      "name": "input-file",
      "type": "string",
      "occurs": "?",
      "aliases": [
        "inputFile"
      ],
      "description": "Path to file containing JSON document input"
    }
  ]
}
