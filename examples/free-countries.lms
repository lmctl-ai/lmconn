# Chapter: lmconnectors - Country facts over GraphQL (countries.trevorblades.com)
# Shows: a GraphQL POST through lmconn http request --data (n8n needs a dedicated GraphQL node for this);
#        system(argv), the lmconn JSON envelope, one retry on 429/5xx
# Run: lmscript examples/free-countries.lms [ISO2]
# Needs: lmconn on PATH; internet access; no credentials
# exit: 0

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconnectors)");
  exit(0);
}

# HTTP errors still have env.ok=true: inspect result.status before bodyJson.
fn fetch_json(argv) {
  for (attempt in [0, 1]) {
    r = system(argv, 45000);
    if (r.timed_out) {
      println("lmconn timed out");
      exit(1);
    }
    if (trim(r.stdout) == "") {
      println("lmconn returned no envelope (exit " + str(r.code) + ")");
      exit(1);
    }
    env = json_parse(r.stdout);
    if (!env.ok) {
      if (attempt == 0 && (env.error.code == "NETWORK" || env.error.code == "TIMEOUT")) {
        println("Transient " + env.error.code + "; retrying once in 3 seconds");
        sleep_ms(3000);
        continue;
      }
      println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
      exit(1);
    }
    res = env.result;
    if (attempt == 0 && (res.status == 429 || (res.status >= 500 && res.status < 600))) {
      println("HTTP " + str(res.status) + "; retrying once in 3 seconds");
      sleep_ms(3000);
      continue;
    }
    if (!res.ok) {
      println("API failed: HTTP " + str(res.status));
      exit(1);
    }
    if (!res.has("bodyJson") || res.bodyJson == null) {
      println("API returned no JSON body (HTTP " + str(res.status) + ")");
      exit(1);
    }
    return res.bodyJson;
  }
}

code = ARGV.get(0, "JP");
# restcountries.com retired its keyless API in 2026; this GraphQL endpoint needs no key.
query = "{ country(code: \"" + code + "\") { name capital currency languages { name } } }";
body = fetch_json(["lmconn", "http", "request", "https://countries.trevorblades.com/",
  "--data", json_stringify({query: query}), "--timeout", "40000"]);
if (body.has("errors") && body.errors != null) {
  println("GraphQL error: " + json_stringify(body.errors));
  exit(1);
}
country = body.get("data", {}).get("country", null);
if (country == null) {
  println("No country found for ISO2 code " + code + " (use uppercase, e.g. JP, DE, BR)");
  exit(1);
}
langs = [];
for (lang in country.get("languages", [])) {
  push(langs, lang.name);
}
println("name: " + country.name);
println("capital: " + str(country.get("capital", "-")));
println("currency: " + str(country.get("currency", "-")));
println("languages: " + join(langs, ", "));
