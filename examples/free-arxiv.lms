# Chapter: Science - arXiv Atom search
# Shows: Non-JSON HTTP response: extract entry titles and IDs from Atom XML via lmconn http request
# Run: lmscript examples/free-arxiv.lms [term]
# Needs: lmconn and node on PATH, internet access; no credentials
# exit: 0

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconnectors)");
  exit(0);
}

# lmscript has no URL-encoding builtin; pass text as one argv element to Node.
fn url_encode(value) {
  r = system(["node", "-e", "process.stdout.write(encodeURIComponent(process.argv[1]))", "--", value], 5000);
  if (r.timed_out || r.code != 0) {
    println("URL encoding failed (node must be on PATH)");
    exit(1);
  }
  return r.stdout;
}

fn fetch_public(url) {
  for (attempt in [1, 2]) {
    r = system(["lmconn", "http", "request", url, "--timeout", "30000", "--header", "User-Agent: lmconnectors-examples/0.1 (https://github.com/lmctl-ai/lmconnectors)"], 35000);
    if (r.timed_out) {
      println("lmconn timed out");
      exit(1);
    }
    env = json_parse(r.stdout);
    if (!env.ok) {
      println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
      exit(1);
    }
    res = env.result;
    if (attempt == 1 && (res.status == 429 || (res.status >= 500 && res.status <= 599))) {
      println("HTTP " + str(res.status) + ": retrying once in 3 seconds");
      sleep_ms(3000);
    } else {
      if (!res.ok) {
        println("HTTP " + str(res.status) + " from " + url + " (attempt " + str(attempt) + "/2); service unavailable or request rejected");
        exit(1);
      }
      return res;
    }
  }
}

term = ARGV.get(0, "transformer");
res = fetch_public("http://export.arxiv.org/api/query?search_query=all:" + url_encode(term) + "&start=0&max_results=3");
# The HTTP connector calls the raw non-JSON response bodyText.
xml = res.bodyText;
if (!regex_test(xml, r'<feed\b')) {
  println("arXiv returned an unexpected response (expected Atom XML)");
  exit(1);
}
entries = regex_find_all(xml, r'<entry>([\s\S]*?)</entry>');
println("arXiv search: " + term);
count = 0;
for (entry in entries) {
  if (count < 3) {
    title = regex_match(entry[1], r'<title>([\s\S]*?)</title>');
    id = regex_match(entry[1], r'<id>([\s\S]*?)</id>');
    if (title != null && id != null) {
      text = trim(regex_replace(title[1], r'\s+', " ", "g"));
      text = replace(replace(replace(replace(replace(text, "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&apos;", "'"), "&amp;", "&");
      println(text + " | " + trim(id[1]));
      count = count + 1;
    }
  }
}
if (count == 0) { println("No papers found."); }
