# Chapter: lmconn - drive lmconn through system() and parse its envelope
# Shows: lmconn as a plain process: system(argv, timeoutMs) with shell:false, the one-line JSON envelope
#        {ok, result} | {ok:false, error:{code, message}}, exit codes 0 / 1 (runtime) / 2 (usage).
# Run: lmscript examples/llm-chat.lms [provider] [prompt]      (lmconn on PATH: `npm link` in the repo)
# Needs: lmconn on PATH; a key for the provider (lmconn cred set deepseek api_key --env DEEPSEEK_API_KEY)
#        or the provider's env var. Without a key the run prints the error envelope and exits 1.
# exit: 0
provider = ARGV.get(0, "deepseek");
prompt = ARGV.get(1, "Reply with the single word: ok");

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconn)");
  exit(0);
}

r = system(["lmconn", "llm", "chat", provider, "--prompt", prompt, "--max-tokens", "32"], 120000);
if (r.timed_out) {
  println("lmconn timed out");
  exit(1);
}
env = json_parse(r.stdout);               # exactly one JSON object on stdout, whatever the exit code
if (!env.ok) {
  # exit 2 is a usage error (bad flags), exit 1 a runtime failure (MISSING_KEY, HTTP_ERROR, TIMEOUT, ...)
  println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
  exit(1);
}
res = env.result;
println("provider: " + res.provider + ", model: " + str(res.model));
println("answer: " + trim(res.text));
if (res.has("usage") && res.usage != null) {
  println("tokens: " + str(res.usage.get("total_tokens", "n/a")));
}
