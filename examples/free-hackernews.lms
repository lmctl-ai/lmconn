# Chapter: lmconnectors - Hacker News search
# Shows: Search Algolia stories with an encoded query and print five hits
# Run: lmscript examples/free-hackernews.lms [query]
# Needs: lmconn on PATH; internet access; no credentials
# exit: 0

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconnectors)");
  exit(0);
}

fn request_json(argv) {
  for (attempt = 0; attempt < 2; attempt = attempt + 1) {
    r = system(argv, 45000);
    if (r.timed_out) {
      println("lmconn timed out");
      exit(1);
    }
    env = json_parse(r.stdout);
    if (!env.ok) {
      println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
      exit(1);
    }
    res = env.result;
    if (attempt == 0 && (res.status == 429 || (res.status >= 500 && res.status < 600))) {
      println("HTTP " + str(res.status) + ": retrying once in 3 seconds");
      sleep_ms(3000);
      continue;
    }
    if (res.status == 429) {
      println("HTTP 429: rate-limited after retry; try again later");
      exit(1);
    }
    if (!res.ok) {
      println("HTTP request failed: " + str(res.status) + " " + res.url);
      exit(1);
    }
    if (!res.has("bodyJson")) {
      println("HTTP response was not JSON: " + res.url);
      exit(1);
    }
    return res.bodyJson;
  }
}

# Percent-encode UTF-8 query values; this lmscript version has no URL encoder builtin.
fn url_encode(value) {
  encoded = "";
  for (c in value) {
    n = char_code(c, 0);
    if ((n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || c == "-" || c == "_" || c == "." || c == "~") {
      encoded = encoded + c;
    } else {
      if (n >= 55296 && n <= 56319) {
        n = 65536 + (n - 55296) * 1024 + char_code(c, 1) - 56320;
      }
      bytes = [n];
      if (n >= 65536) {
        bytes = [240 + floor(n / 262144), 128 + floor(n / 4096) % 64, 128 + floor(n / 64) % 64, 128 + n % 64];
      } else if (n >= 2048) {
        bytes = [224 + floor(n / 4096), 128 + floor(n / 64) % 64, 128 + n % 64];
      } else if (n >= 128) {
        bytes = [192 + floor(n / 64), 128 + n % 64];
      }
      hex = "0123456789ABCDEF";
      for (b in bytes) { encoded = encoded + "%" + hex[floor(b / 16)] + hex[b % 16]; }
    }
  }
  return encoded;
}

query = ARGV.get(0, "llm agents");
url = "https://hn.algolia.com/api/v1/search?query=" + url_encode(query) + "&tags=story&hitsPerPage=5";
body = request_json(["lmconn", "http", "request", url]);
println("Hacker News: " + query + " (" + str(body.hits.len()) + " hits)");
for (hit in body.hits) {
  println(str(hit.title) + " | author: " + str(hit.author) + " | points: " + str(hit.points) + " | url: " + str(hit.url));
}
