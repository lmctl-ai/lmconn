# Chapter: lmconnectors - Public IP information
# Shows: Look up this machine public IP using ipapi.co, with one retry for rate limiting
# Run: lmscript examples/free-ip.lms 
# Needs: lmconn on PATH; internet access; no credentials
# exit: 0

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconnectors)");
  exit(0);
}

fn request_json(argv) {
  for (attempt = 0; attempt < 2; attempt = attempt + 1) {
    r = system(argv, 45000);
    if (r.timed_out) {
      println("lmconn timed out");
      exit(1);
    }
    env = json_parse(r.stdout);
    if (!env.ok) {
      println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
      exit(1);
    }
    res = env.result;
    if (attempt == 0 && (res.status == 429 || (res.status >= 500 && res.status < 600))) {
      println("HTTP " + str(res.status) + ": retrying once in 3 seconds");
      sleep_ms(3000);
      continue;
    }
    if (res.status == 429) {
      println("HTTP 429: rate-limited after retry; try again later");
      exit(1);
    }
    if (!res.ok) {
      println("HTTP request failed: " + str(res.status) + " " + res.url);
      exit(1);
    }
    if (!res.has("bodyJson")) {
      println("HTTP response was not JSON: " + res.url);
      exit(1);
    }
    return res.bodyJson;
  }
}

body = request_json(["lmconn", "http", "request", "https://ipapi.co/json/"]);
if (body.get("error", false)) {
  println("IP lookup failed: " + str(body.get("reason", "unknown API error")));
  exit(1);
}
println("ip: " + str(body.ip) + ", city: " + str(body.city) + ", country: " + str(body.country_name) + ", org: " + str(body.org));
