# Chapter: lmconnectors - Current weather from Open-Meteo
# Shows: Coordinates, HTTP retry, and temperature/windspeed/weathercode; system(argv) and the lmconn JSON envelope
# Run: lmscript examples/free-weather-openmeteo.lms [lat] [lon]
# Needs: lmconn on PATH; internet access; no credentials
# exit: 0

if (which("lmconn") == null) {
  println("SKIPPED: lmconn is not on PATH (run `npm link` in lmconnectors)");
  exit(0);
}

# HTTP errors still have env.ok=true: inspect result.status before bodyJson.
fn fetch_json(argv) {
  for (attempt in [0, 1]) {
    r = system(argv, 45000);
    if (r.timed_out) {
      println("lmconn timed out");
      exit(1);
    }
    if (trim(r.stdout) == "") {
      println("lmconn returned no envelope (exit " + str(r.code) + ")");
      exit(1);
    }
    env = json_parse(r.stdout);
    if (!env.ok) {
      if (attempt == 0 && (env.error.code == "NETWORK" || env.error.code == "TIMEOUT")) {
        println("Transient " + env.error.code + "; retrying once in 3 seconds");
        sleep_ms(3000);
        continue;
      }
      println("lmconn failed (exit " + str(r.code) + "): " + env.error.code + ": " + env.error.message);
      exit(1);
    }
    res = env.result;
    if (attempt == 0 && (res.status == 429 || (res.status >= 500 && res.status < 600))) {
      println("HTTP " + str(res.status) + "; retrying once in 3 seconds");
      sleep_ms(3000);
      continue;
    }
    if (!res.ok) {
      println("API failed: HTTP " + str(res.status));
      exit(1);
    }
    if (!res.has("bodyJson") || res.bodyJson == null) {
      println("API returned no JSON body (HTTP " + str(res.status) + ")");
      exit(1);
    }
    return res.bodyJson;
  }
}

lat = ARGV.get(0, "52.52");
lon = ARGV.get(1, "13.41");
url = "https://api.open-meteo.com/v1/forecast?latitude=" + str(num(lat)) + "&longitude=" + str(num(lon)) + "&current_weather=true";
body = fetch_json(["lmconn", "http", "request", url, "--timeout", "40000"]);
weather = body.current_weather;
println("temperature: " + str(weather.temperature) + " " + body.current_weather_units.temperature);
println("windspeed: " + str(weather.windspeed) + " " + body.current_weather_units.windspeed);
println("weathercode: " + str(weather.weathercode));
