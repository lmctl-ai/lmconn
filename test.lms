# npm install -g @lmctl-ai/lmctl provides both lmctl and lmscript.
# Put the released lmmock on PATH (or set LMMOCK_BIN) before running.
result = system(["node", "scripts/sync-lmmock.mjs", "--check"], {timeoutMs:600000});
print(result.stdout); print(result.stderr);
assert(result.code == 0, "fixture lock verification failed");
# Node's test runner handles discovery consistently on Windows and Unix.
result = system(["node", "--test", "test/*.test.js"], {timeoutMs:600000});
print(result.stdout); print(result.stderr);
assert(result.code == 0, "connector tests failed");
